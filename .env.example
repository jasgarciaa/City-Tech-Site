# Supabase — get from: Supabase Dashboard > Project Settings > API
# New projects (post-Nov 2025) use PUBLISHABLE key (sb_publishable_...).
# If your dashboard shows ANON key instead, use NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Resend — get from: resend.com > API Keys
# NEVER prefix with NEXT_PUBLIC_ — this is server-only
RESEND_API_KEY=re_your_key_here
