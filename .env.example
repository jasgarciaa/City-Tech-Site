# Supabase — get from: Supabase Dashboard > Project Settings > API
# New projects (post-Nov 2025) use PUBLISHABLE key (sb_publishable_...).
# If your dashboard shows ANON key instead, use NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Resend — get from: resend.com > API Keys
# NEVER prefix with NEXT_PUBLIC_ — this is server-only
RESEND_API_KEY=re_your_key_here

# Site URL — used by app/sitemap.ts, app/robots.ts, and openGraph url fields
# Set to the production domain once confirmed. Falls back to https://citytechllc.com
# if unset (safe default but Google will index whatever value is here in production).
NEXT_PUBLIC_SITE_URL=https://citytechllc.com
